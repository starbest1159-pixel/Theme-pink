# APP_URL: Public base URL where the app is hosted.
APP_URL=""

# --- Server-Side Only: Series Jeen API ---
# SERIESJEEN_API_KEY is the ONLY API credential. Never expose it to browser/UI.
# Accepted upstream origins are restricted in server code to Series Jeen domains.
SERIESJEEN_API_KEY=""
# Comma-separated platform slugs enabled on your key (e.g. dramabox,reelshort,shortmax,netshort,wetv,iqiyi)
SERIESJEEN_PLATFORMS="dramabox,reelshort,wetv,iqiyi"
# Locale code for titles & descriptions (default: th)
SERIESJEEN_LOCALE="th"
# Items per platform page (default: 20, max: 50)
SERIESJEEN_PAGE_SIZE="20"
# In-memory cache TTL in ms to protect against rate limits (default: 60000)
SERIESJEEN_CACHE_TTL_MS="60000"
# Upstream request timeout in ms (default: 8000)
SERIESJEEN_TIMEOUT_MS="8000"

# --- Optional: Android APK / WebView Cross-Origin Support ---
CORS_ALLOWED_ORIGINS="capacitor://localhost,https://localhost,http://localhost"
VITE_API_ORIGIN=""
